# Cloudflare static assets bypass the Worker. vinext's Node preview does not apply this file.
# Unversioned images must revalidate; only fingerprinted assets receive immutable caching.
/assets/sequence-desktop/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/sequence-mobile/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/fallbacks/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/references/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/posters/tour-desktop-bdc60fe2.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/posters/tour-mobile-bdc60fe2.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/hero-factory-blur.5c8cc607ef5b.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/logo-mark.v2.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/hero-lockup.v2.webp
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
